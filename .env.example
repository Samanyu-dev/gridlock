# ---------------------------------------------------------------------------
# GRIDLOCK environment configuration
# Copy to .env (local) or set these in your Vercel project settings.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Database. Defaults to a local SQLite file when unset. In production use a
# Postgres connection string (Vercel Postgres / Neon / any Postgres).
# postgres:// URLs are auto-normalized to postgresql://.
DATABASE_URL=

# Motorsport data source behind the MotorsportDataProvider adapter.
#   mock  — deterministic seeded season (default; no credentials needed)
#   real  — a live feed adapter (OpenF1 / Ergast-compatible / commercial); not
#           implemented in this build, provided as an architectural seam.
MOTORSPORT_DATA_PROVIDER=mock

# Demo mode keeps the experience fully populated (managers, leagues,
# leaderboards, live race) without any auth or external API.
DEMO_MODE=true
